# BreatheWise AI Environment Variables

# Google Gemini API Key (Required for AI Assistant, Personalized Daily Planner, and Indoor Air Quality recommendations)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication & Database (Optional - App provides seamless demo storage if not set)
# Get your credentials at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

